{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bill.schema.json",
  "$defs": {
    "BilingualLabel": {
      "additionalProperties": false,
      "description": "Display name with both languages, as every enum value has (requirement 1.13).",
      "properties": {
        "zh": {
          "minLength": 1,
          "title": "Zh",
          "type": "string"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "title": "BilingualLabel",
      "type": "object"
    },
    "BoolField": {
      "additionalProperties": false,
      "description": "A boolean field.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "const": "bool",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "BoolField",
      "type": "object"
    },
    "DateField": {
      "additionalProperties": false,
      "description": "A date field; ``default_context: today`` defaults it to the anchor date.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "const": "date",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "default_context": {
          "anyOf": [
            {
              "const": "today",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Context"
        }
      },
      "required": [
        "type"
      ],
      "title": "DateField",
      "type": "object"
    },
    "DecimalField": {
      "additionalProperties": false,
      "description": "A qty, price, money or rate field, optionally limited to the listed ``values``.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "enum": [
            "qty",
            "price",
            "money",
            "rate"
          ],
          "title": "Type",
          "type": "string"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "default": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "DecimalField",
      "type": "object"
    },
    "EnumField": {
      "additionalProperties": false,
      "description": "An enum field: ``values`` maps each code to its zh and en labels, in order.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "const": "enum",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/BilingualLabel"
            }
          },
          "title": "Values",
          "type": "object"
        },
        "default": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type",
        "values"
      ],
      "title": "EnumField",
      "type": "object"
    },
    "IntField": {
      "additionalProperties": false,
      "description": "An integer field.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "const": "int",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "IntField",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "description": "Display name of an object or field: ``{ zh: 名称 }`` or ``{ zh: 供应商, en: Supplier }``.",
      "properties": {
        "zh": {
          "minLength": 1,
          "title": "Zh",
          "type": "string"
        },
        "en": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En"
        }
      },
      "required": [
        "zh"
      ],
      "title": "Label",
      "type": "object"
    },
    "LineQuantityDef": {
      "additionalProperties": false,
      "description": "``line_quantity``: the quantity semantics of a bill's lines (requirement 1.4).\n\n``material_field`` and ``unit_field`` are the ref fields to the measured entity and to\nthe unit entity; ``qty_field`` names the qty field a bill without pricing measures,\nwhile a bill with pricing uses the standard ``qty``. The engine adds the read-only\n``qty_base`` to such lines. Step 5 checks the fields and the combination with pricing\n(requirement 6.12).",
      "properties": {
        "material_field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Material Field",
          "type": "string"
        },
        "unit_field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Unit Field",
          "type": "string"
        },
        "qty_field": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qty Field"
        }
      },
      "required": [
        "material_field",
        "unit_field"
      ],
      "title": "LineQuantityDef",
      "type": "object"
    },
    "NumberDef": {
      "additionalProperties": false,
      "description": "``number: { prefix: CGDD }``: the prefix of the bill numbers (requirement 4.4).\n\nA number is ``<prefix><biz_date as YYYYMMDD><4 digits>``, so only the prefix is\ndeclared.",
      "properties": {
        "prefix": {
          "pattern": "^[A-Z][A-Z0-9]*$",
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "prefix"
      ],
      "title": "NumberDef",
      "type": "object"
    },
    "PartnerDef": {
      "additionalProperties": false,
      "description": "``partner: { field: supplier_id }``: the bill's partner field (meta-model.md 4).",
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "PartnerDef",
      "type": "object"
    },
    "PeriodField": {
      "additionalProperties": false,
      "description": "An accounting period field, YYYY-MM.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "const": "period",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "PeriodField",
      "type": "object"
    },
    "RefField": {
      "additionalProperties": false,
      "description": "A reference to a record of the entity or bill named by ``ref``.\n\nIts name ends with ``_id``; results return it under the name without ``_id``\n(requirement 13.3). ``default_context`` org and user give the default organization\nand the current user.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "const": "ref",
          "title": "Type",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Ref",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "default_context": {
          "anyOf": [
            {
              "enum": [
                "org",
                "user"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Context"
        }
      },
      "required": [
        "type",
        "ref"
      ],
      "title": "RefField",
      "type": "object"
    },
    "SearchDef": {
      "additionalProperties": false,
      "description": "``search``: the parameters and the order of a search tool (requirement 5.9 to 5.14).\n\nEvery list may be omitted: without ``keyword_fields`` the tool has no keyword parameter,\nwithout ``filters`` no filters, and without ``default_sort`` the results are ordered by\nid alone.",
      "properties": {
        "keyword_fields": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Keyword Fields",
          "type": "array"
        },
        "filters": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "default_sort": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(?: (?:asc|desc))?$",
            "type": "string"
          },
          "title": "Default Sort",
          "type": "array"
        }
      },
      "title": "SearchDef",
      "type": "object"
    },
    "StandardOverride": {
      "additionalProperties": false,
      "description": "A same-name declaration of an engine standard field without ``type``.\n\nAllowed in a bill's header and lines only (requirement 1.5), for instance\n``tax_rate: { default_from: material.tax_rate }``. It accepts the 7 field attributes\nand nothing else; ``default`` is a str, int or bool, and its type is not known before\nstep 5 resolves the standard field.\n\nStep 5 decides what such a declaration may say (requirement 1.6): only label and the\ndefault attributes, defaults only for a writable standard field, and a default that\nfits the standard field's type. It reads the declared attributes from\n``model_fields_set``, as for a typed same-name declaration, so required, readonly and\nunique are accepted here and reported there with the bill and field name.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "default_context": {
          "anyOf": [
            {
              "enum": [
                "today",
                "org",
                "user"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Context"
        }
      },
      "title": "StandardOverride",
      "type": "object"
    },
    "StringField": {
      "additionalProperties": false,
      "description": "A string or text field; ``maxLength`` limits its length in code points.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default_from": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default From"
        },
        "type": {
          "enum": [
            "string",
            "text"
          ],
          "title": "Type",
          "type": "string"
        },
        "maxLength": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "StringField",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A bill document: a header and its lines (meta-model.md section 4).\n\n``state_machine`` is required and selects one of the two preset state machines; a\ndocument without it, or with any other value, is a step 4 error that names the bill\n(requirement 1.9). ``pricing`` turns on the quantity, price and amount fields of the\npricing primitive (requirement 6.1).",
  "properties": {
    "bill": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Bill",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "$ref": "#/$defs/Label"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id_prefix": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id Prefix",
      "type": "string"
    },
    "number": {
      "$ref": "#/$defs/NumberDef"
    },
    "state_machine": {
      "enum": [
        "standard",
        "simple"
      ],
      "title": "State Machine",
      "type": "string"
    },
    "pricing": {
      "default": false,
      "title": "Pricing",
      "type": "boolean"
    },
    "partner": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartnerDef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "header": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "anyOf": [
            {
              "$ref": "#/$defs/StringField"
            },
            {
              "$ref": "#/$defs/IntField"
            },
            {
              "$ref": "#/$defs/BoolField"
            },
            {
              "$ref": "#/$defs/EnumField"
            },
            {
              "$ref": "#/$defs/DateField"
            },
            {
              "$ref": "#/$defs/PeriodField"
            },
            {
              "$ref": "#/$defs/DecimalField"
            },
            {
              "$ref": "#/$defs/RefField"
            },
            {
              "$ref": "#/$defs/StandardOverride"
            }
          ]
        }
      },
      "title": "Header",
      "type": "object"
    },
    "lines": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "anyOf": [
            {
              "$ref": "#/$defs/StringField"
            },
            {
              "$ref": "#/$defs/IntField"
            },
            {
              "$ref": "#/$defs/BoolField"
            },
            {
              "$ref": "#/$defs/EnumField"
            },
            {
              "$ref": "#/$defs/DateField"
            },
            {
              "$ref": "#/$defs/PeriodField"
            },
            {
              "$ref": "#/$defs/DecimalField"
            },
            {
              "$ref": "#/$defs/RefField"
            },
            {
              "$ref": "#/$defs/StandardOverride"
            }
          ]
        }
      },
      "title": "Lines",
      "type": "object"
    },
    "line_quantity": {
