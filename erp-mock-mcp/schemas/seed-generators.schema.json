{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-generators.schema.json",
  "$defs": {
    "ChoiceGenerator": {
      "additionalProperties": false,
      "description": "One of ``values``, drawn from the dataset's random sequence.",
      "properties": {
        "gen": {
          "const": "choice",
          "title": "Gen",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "gen",
        "values"
      ],
      "title": "ChoiceGenerator",
      "type": "object"
    },
    "CodeWordsGenerator": {
      "additionalProperties": false,
      "description": "A text built from ``words``, for names and specifications.",
      "properties": {
        "gen": {
          "const": "code_words",
          "title": "Gen",
          "type": "string"
        },
        "words": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "gen",
        "words"
      ],
      "title": "CodeWordsGenerator",
      "type": "object"
    },
    "CompanyNameGenerator": {
      "additionalProperties": false,
      "description": "A company name; ``industry`` narrows the words it is built from (seed-data.md 1).",
      "properties": {
        "gen": {
          "const": "company_name",
          "title": "Gen",
          "type": "string"
        },
        "industry": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        }
      },
      "required": [
        "gen"
      ],
      "title": "CompanyNameGenerator",
      "type": "object"
    },
    "DecimalRangeGenerator": {
      "additionalProperties": false,
      "description": "A decimal between ``min`` and ``max``, both included and written as text.",
      "properties": {
        "gen": {
          "const": "decimal_range",
          "title": "Gen",
          "type": "string"
        },
        "min": {
          "minLength": 1,
          "title": "Min",
          "type": "string"
        },
        "max": {
          "minLength": 1,
          "title": "Max",
          "type": "string"
        }
      },
      "required": [
        "gen",
        "min",
        "max"
      ],
      "title": "DecimalRangeGenerator",
      "type": "object"
    },
    "IntRangeGenerator": {
      "additionalProperties": false,
      "description": "An integer between ``min`` and ``max``, both included.",
      "properties": {
        "gen": {
          "const": "int_range",
          "title": "Gen",
          "type": "string"
        },
        "min": {
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "gen",
        "min",
        "max"
      ],
      "title": "IntRangeGenerator",
      "type": "object"
    },
    "PersonNameGenerator": {
      "additionalProperties": false,
      "description": "A person's name.",
      "properties": {
        "gen": {
          "const": "person_name",
          "title": "Gen",
          "type": "string"
        }
      },
      "required": [
        "gen"
      ],
      "title": "PersonNameGenerator",
      "type": "object"
    },
    "ShortNameGenerator": {
      "additionalProperties": false,
      "description": "A short name derived from the record's name.",
      "properties": {
        "gen": {
          "const": "short_name",
          "title": "Gen",
          "type": "string"
        }
      },
      "required": [
        "gen"
      ],
      "title": "ShortNameGenerator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``seed/generators.yaml``: the generator of each entity field (design.md data model 1).\n\nKeys are written ``<entity>.<field>``. A field without a generator keeps its default\nvalue when the Seed_Builder generates a record (requirement 20.4). Step 5 resolves the\nentities and fields.",
  "properties": {
    "generators": {
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompanyNameGenerator"
            },
            {
              "$ref": "#/$defs/ShortNameGenerator"
            },
            {
              "$ref": "#/$defs/PersonNameGenerator"
            },
            {
              "$ref": "#/$defs/ChoiceGenerator"
            },
            {
              "$ref": "#/$defs/IntRangeGenerator"
            },
            {
              "$ref": "#/$defs/DecimalRangeGenerator"
            },
            {
              "$ref": "#/$defs/CodeWordsGenerator"
            }
          ]
        }
      },
      "title": "Generators",
      "type": "object"
    }
  },
  "title": "SeedGeneratorsFile",
  "type": "object"
}
